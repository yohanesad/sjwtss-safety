# Salin menjadi .env lalu ganti nilainya. Nilai contoh ditolak aplikasi.

# PostgreSQL. Untuk Vercel/serverless pakai alamat "pooled" (Supabase: port 6543).
DATABASE_URL="postgresql://user:password@localhost:5432/safety?schema=public"
# Khusus migrasi bila penyedia memberi alamat terpisah (Supabase: Session pooler, port 5432).
# DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Kunci penanda tangan cookie sesi staf, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Alamat publik situs (untuk isi QR). Isi bila sudah punya domain tetap.
# APP_URL="https://induksi.perusahaan.co.id"

# Aturan induksi (semua opsional, ini nilai bawaan)
# VIDEO_DURATION_SECONDS=240      # lama video 4 menit
# VIDEO_MIN_WATCH_PERCENT=90      # server menolak "selesai" bila waktu berjalan < 90% durasi
# INDUCTION_VALID_DAYS=90         # masa berlaku induksi pengunjung berulang (3 bulan)
# QUIZ_PASS_PERCENT=100          # semua soal harus benar
# Video dari YouTube (disarankan: unlisted). Tempel tautan atau ID-nya.
VIDEO_YOUTUBE="https://youtu.be/4sUxKaVpqVc"
# Atau berkas sendiri di public/videos (dipakai bila VIDEO_YOUTUBE kosong):
# VIDEO_SRC=/videos/induksi.mp4
